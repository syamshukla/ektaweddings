# Public URL once a domain is live (used for sitemap + social cards)
NEXT_PUBLIC_SITE_URL=

# Inquiry emails via https://resend.com (free tier). Without these, inquiries are
# printed to the terminal in dev and show an "Instagram DM" message in production.
RESEND_API_KEY=
INQUIRY_TO_EMAIL=
# Needs a verified domain in Resend; the default test sender only delivers to your Resend account email.
INQUIRY_FROM_EMAIL=
